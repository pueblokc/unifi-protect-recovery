docs-local-only/

# Encryption keys and credentials
*_keys.json
*.unifi

# Binary test files
*.bin

# Search/debug outputs
*_results.txt

# SSH host keys remembered by the Python GUI (trust-on-first-use)
known_hosts

# Python tooling
.pytest_cache/
.ruff_cache/
